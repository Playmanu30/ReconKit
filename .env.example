# ReconKit settings. Copy this file to .env and fill in what you use.

# --- AI analysis (optional) -------------------------------------------------
# Any OpenAI-compatible endpoint works. With no key, ReconKit uses a local,
# rule-based summary and nothing leaves the machine.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Local model through Ollama (no cloud, no cost):
#   winget install Ollama.Ollama
#   ollama pull qwen2.5:3b
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen2.5:3b

# --- third-party APIs (optional) --------------------------------------------
# SHODAN_API_KEY=your_key_here
# Censys Platform Personal Access Token (free tier supports host lookup):
# CENSYS_API_TOKEN=censys_xxx
# Legacy Censys Search v2 credentials (optional):
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# --- local overrides --------------------------------------------------------
# Point at a specific binary when it is not on PATH. Path only, no arguments.
# RECON_HTTPX=C:\Tools\httpx.exe
# RECON_NMAP=C:\Program Files (x86)\Nmap\nmap.exe
# RECON_SPIDERFOOT=C:\Tools\spiderfoot\sf.py

# RECON_PORT=8777
# RECON_NO_BROWSER=1
